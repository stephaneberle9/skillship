{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephaneberle9/skillship/schemas/distro.schema.json",
  "title": "skillship distro profile (distro.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["include"],
  "properties": {
    "recipient": {
      "description": "Who receives this distro, for people reading the profile. Required unless every target is an `archive`, a `skill-upload` or a `plugin-upload`; such a profile defaults to early adopters who are handed the zip or upload it themselves.",
      "type": "string",
      "minLength": 1
    },
    "include": {
      "description": "Skills to deliver, with everything they require. `plugin:glob` or a bare glob that matches a skill name in any plugin.",
      "$ref": "#/$defs/patterns",
      "minItems": 1
    },
    "exclude": {
      "description": "Skills never to deliver. Resolving fails when an included skill is excluded or requires one.",
      "$ref": "#/$defs/patterns"
    },
    "acknowledge": {
      "description": "Skills a delivered file names that do not ship, accepted as they are.",
      "$ref": "#/$defs/patterns"
    },
    "plugin-extras": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "description": "Deliver each shipping plugin's `.mcp.json`, `CONNECTORS.md` and `connectors/`.",
          "type": "boolean"
        },
        "readme": {
          "description": "Generate a README listing the shipped skills; always on in a marketplace.",
          "type": "boolean"
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "description": "Globs, relative to each skill directory, of files never to deliver.",
          "$ref": "#/$defs/patterns"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "description": "`skills`: the skills side by side, without plugins. `marketplace`: the source's plugins that ship a skill, one or several, with a generated `marketplace.json`.",
          "enum": ["skills", "marketplace"]
        },
        "root": {
          "description": "Subdirectory inside the target that receives the tree: a relative path without `..`.",
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "merged-plugin": {
          "description": "The one plugin of the marketplace that every shipped skill is merged into, whichever source plugin it comes from. Without it the marketplace keeps the source's plugins. Shape `marketplace` only.",
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "description": "Name of the merged plugin.",
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "description": {
              "description": "Description of the merged plugin.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "marketplace": {
          "description": "Name of the generated marketplace, for shape `marketplace`. Defaults to the distro name.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "if": { "required": ["merged-plugin"] },
      "then": { "properties": { "shape": { "const": "marketplace" } }, "required": ["shape"] }
    },
    "license": {
      "description": "`inherit`, `none`, or an SPDX license identifier.",
      "type": "string",
      "minLength": 1
    },
    "version": { "enum": ["keep", "bump-patch"] },
    "auto": { "type": "boolean" },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline-shared": {
          "description": "For `skill-upload`: copy a plugin's `shared-material/` into each skill whose paths lead there, and point those paths at the copy.",
          "type": "boolean"
        }
      }
    },
    "target-files": {
      "description": "Opt out of a target-file set of the source repo with `<set>: false`.",
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "patterns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "target": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["archive", "skill-upload", "plugin-upload", "agensi", "git"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "archive" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "name": {
                "description": "File name of the zip, without `.zip`. Defaults to the distro name.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["skill-upload", "plugin-upload"] }
            }
          },
          "then": {
            "additionalProperties": false,
            "properties": { "type": true }
          }
        },
        {
          "if": { "properties": { "type": { "const": "agensi" } } },
          "then": {
            "additionalProperties": false,
            "properties": {
              "type": true,
              "name": {
                "description": "File name of the package, without `.zip`. Defaults to the distro name.",
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"
              },
              "title": {
                "description": "The pack's name, as the heading of its README. Defaults to the distro name.",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "git" } } },
          "then": {
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "type": true,
              "url": { "type": "string", "minLength": 1 },
              "branch": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["push", "pull-request", "merge-request"] },
              "forge": { "enum": ["github", "gitlab"] }
            }
          }
        }
      ]
    }
  }
}
